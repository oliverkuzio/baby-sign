{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babysign",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "routes": [
    {
      "pattern": "sign.kuzio.app",
      "custom_domain": true
    }
  ],

  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "babysign",
      "database_id": "72bb2e65-ef80-4d90-8847-92fa5c19a3a5",
      "migrations_dir": "./drizzle"
    }
  ],

  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  "vars": {
    // Not secret — Better Auth's own recommended way to pin its base origin
    // instead of trusting request headers. Overridden to localhost for
    // local dev via `.dev.vars` (which takes precedence over this).
    "BETTER_AUTH_URL": "https://sign.kuzio.app",
    // Not secret — base URL for the sign-image CDN, read via `platform.env`
    // (see `+layout.server.ts`) rather than `$env/static/public` so it's
    // available at runtime without needing a build-time env var.
    "PUBLIC_IMAGE_URL": "https://res.cloudinary.com/spiralyze/image/upload/f_auto,w_auto/BabySignLanguage/DictionaryPages"
  }

  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */

  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
}
